{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "lib",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "moduleDetection": "legacy"
  },
  "include": ["src/**/*.ts"]
}
